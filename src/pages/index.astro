---
import '../styles/global.css';

const name = "Tejas Nagesh Kulkarni";
const email = "f20240460@goa.bits-pilani.ac.in";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{name} | Curriculum Vitae</title>
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&display=swap" rel="stylesheet">
    </head>
    
    <body class="bg-[#FAFAFA] text-[#111111] font-['Newsreader'] antialiased selection:bg-sky-100">
        
        <div class="h-1.5 w-full bg-gradient-to-r from-sky-300 via-lime-300 to-[#FAFAFA]"></div>

        <header class="w-full border-b border-slate-200 bg-[#FAFAFA]/90 backdrop-blur-sm sticky top-0 z-50">
            <div class="max-w-3xl mx-auto px-6 h-16 flex items-center justify-between text-[15px]">
                <a href="/" class="font-medium tracking-tight text-slate-800 hover:text-sky-600 transition-colors">
                    {name}
                </a>
                <nav class="flex items-center gap-6 font-medium text-slate-500">
                    <a href="/" class="text-slate-900 border-b border-slate-900 pb-0.5">CV</a>
                    <a href="/photography" class="hover:text-slate-900 transition-colors pb-0.5">Photography</a>
                    <a href={`mailto:${email}`} class="hover:text-slate-900 transition-colors pb-0.5">Email</a>
                </nav>
            </div>
        </header>

        <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">
            
            <section class="mb-24">
                <div class="flex flex-col md:flex-row justify-between md:items-end mb-10 gap-6">
                    <div>
                        <h1 class="text-4xl md:text-5xl tracking-tight mb-2 text-slate-900 font-medium">
                            {name}
                        </h1>
                        <p class="text-slate-600 font-medium text-lg">
                            <a href="https://www.bits-pilani.ac.in/goa/" target="_blank" class="hover:text-sky-700 transition-colors">BITS Pilani, Goa Campus</a>
                        </p>
                    </div>
                    <a href={`mailto:${email}`} class="border border-sky-200 text-sky-700 px-5 py-2 rounded-full text-[15px] font-medium hover:bg-sky-50 transition-colors">
                        Email Me
                    </a>
                </div>
                
                <h2 class="text-2xl md:text-3xl leading-snug text-slate-800 max-w-2xl font-medium">
                    Aspiring Mechanical Engineer with key interests in <span class="bg-lime-100/70 text-lime-900 px-1.5 py-0.5 rounded-sm">Artificial Intelligence</span>, <strong>Digital Twins</strong>, and <strong>Robotics</strong>.
                </h2>

                <div class="flex gap-5 mt-10 text-[15px] font-medium text-slate-500">
                    <a href="https://github.com/tejas-nk" class="hover:text-sky-700 underline underline-offset-4 decoration-slate-200 transition-colors">GitHub</a>
                    <a href="https://www.linkedin.com/in/tejaskulkarni25" class="hover:text-sky-700 underline underline-offset-4 decoration-slate-200 transition-colors">LinkedIn</a>
                    <a href="/tejas_kulkarni_cv.pdf" target="_blank" class="hover:text-sky-700 underline underline-offset-4 decoration-slate-200 transition-colors">Download PDF</a>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Education</h3>
                
                <div class="flex flex-col md:flex-row justify-between items-start gap-2">
                    <div>
                        <h4 class="text-xl font-medium text-slate-900">
                            <a href="https://www.bits-pilani.ac.in/goa/" target="_blank" class="hover:text-sky-700 transition-colors">BITS Pilani, Goa Campus</a>
                        </h4>
                        <p class="text-slate-600 mt-1 text-[17px]">B.E. (Hons.) Mechanical Engineering</p>
                    </div>
                    <div class="md:text-right mt-2 md:mt-0">
                        <p class="text-[15px] text-slate-500 font-medium">2024 — 2028</p>
                        <p class="text-[15px] font-semibold text-slate-900 mt-1">CGPA: <span class="text-sky-600">9.47/10</span></p>
                    </div>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Professional Experience</h3>
                
                <div class="space-y-12">
                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Engineering Intern</h4>
                            <span class="text-[15px] text-slate-500 font-medium">May 2026 — Jul 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">
                            <a href="https://www.jaguarlandrover.com/" target="_blank" class="hover:text-sky-800 transition-colors">Jaguar Land Rover (TATA Motors)</a>
                        </p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Authored the <strong>Software Requirements Specification (SRS)</strong> and <strong>UI design</strong> for a tablet-based digital check-sheet application that replaced a paper-based shop-floor workflow, defining <strong>real-time error-tracking logic</strong> and <strong>automated reporting</strong>.</li>
                            <li>Wrote <strong>Python scripts</strong> to process and analyze <strong>100k+ inspection records</strong>, isolating the highest-impact failure patterns and informing process changes that cut vehicle send-back costs by <strong>10–12%</strong> (~INR 9 lakh/month).</li>
                            <li>Built an <strong>automated analysis workflow</strong> over <strong>20,000+ diagnostic trouble code (DTC) logs</strong> to surface <strong>root-cause patterns</strong> and accelerate investigations by ~20% across engineering and quality teams.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Teaching Assistant, Engineering Design and Prototyping</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Aug 2025 — May 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">
                            <a href="https://www.bits-pilani.ac.in/goa/mechanical-engineering/" target="_blank" class="hover:text-sky-800 transition-colors">Dept of Mechanical Engineering, BITS Goa</a>
                        </p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Managed end-to-end delivery of a <strong>hands-on engineering course</strong> for <strong>400+ students</strong> across 2 semesters, coordinating a multi-section teaching team and ensuring consistent evaluation.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Core Member & Lead Cinematographer</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Sep 2025 — Apr 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Film Making Club, BITS Goa</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Led a <strong>cross-functional team</strong> of student producers to deliver a film screened to <strong>1,000+ students</strong>, managing <strong>production planning</strong>, budgeting, and timeline.</li>
                        </ul>
                    </article>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Projects</h3>
                
                <div class="space-y-12">
                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Physics-Based Digital Twin for Uncertainty-Aware Thermo-Mechanical Analysis of Cryogenic Pipeline Support Structures</h4>
                            <span class="text-[15px] text-slate-500 font-medium">2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Python, Ansys, Monte Carlo</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Developed a <strong>thermo-mechanical digital-twin</strong> of cryogenic piping structures and evaluated <strong>200+ simulated operating scenarios</strong> using <strong>Monte Carlo</strong> and <strong>Latin Hypercube Simulations</strong> for structural design considering <strong>parameter uncertainty</strong>.</li>
                            <li>Built a <strong>Python-based analytics workflow</strong> to assess behaviour relevant to <strong>LNG Pipelines</strong> and petroleum infrastructure; resulting peer reviewed research accepted at <a href="https://www.asme.org/" target="_blank" class="hover:text-sky-700 underline underline-offset-4 decoration-slate-200 transition-colors">American Society of Mechanical Engineers - Submission</a>.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Stock Price Prediction using Machine Learning</h4>
                            <span class="text-[15px] text-slate-500 font-medium">2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">TensorFlow, Deep Learning</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Built and back-tested a <strong>deep learning pipeline</strong> in <strong>TensorFlow</strong> for <strong>financial time-series prediction</strong> (~55% directional accuracy vs. 50% baseline), translating noisy market data into an <strong>actionable trading signal</strong>.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Bio-Photonics Experiment Design and Data Analysis</h4>
                            <span class="text-[15px] text-slate-500 font-medium">2025 — 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Data Analysis, Research</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Partnered with Dr. Yuriy Petenev & former IIT Bombay Dean Dr. Tapanendu Kundu to design a <strong>data-collection methodology</strong>.</li>
                            <li>Successfully created a dataset of <strong>500k+ observations</strong> and further improving <strong>data quality by ~30%</strong>, research paper now under <strong>peer review</strong>.</li>
                        </ul>
                    </article>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Awards & Recognition</h3>
                
                <div class="space-y-12">
                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">CADFEM APAC Ansys Technology Hackathon 2026</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Apr 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-3">Winner</p>
                        <p class="text-[17px] leading-relaxed text-slate-700 ml-1">
                            Designed a <strong>heat transfer optimization solution</strong> in <strong>Ansys Fluent</strong>, achieving <strong>~20% higher thermal efficiency</strong>.
                        </p>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Nomura Global Markets Quant Challenge 5.0</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Jul 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-3">Special Mention (Finalist)</p>
                        <p class="text-[17px] leading-relaxed text-slate-700 ml-1">
                            Selected among top-performing candidates for <strong>quantitative and algorithmic problem-solving</strong> using <strong>Python, C++</strong>.
                        </p>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">ICIST — International Conference</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Nov 2025</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-3">Best Speaker Award</p>
                        <p class="text-[17px] leading-relaxed text-slate-700 ml-1">
                            Presented <strong>undergraduate research</strong> to 100+ delegates in the <strong>Engineering track</strong>.
                        </p>
                    </article>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Technical Skills</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-5 gap-x-8 text-[17px] text-slate-700">
                    <div>
                        <span class="font-semibold text-slate-900">Programming & Scripting:</span> Python, R, C++, C, MATLAB
                    </div>
                    <div>
                        <span class="font-semibold text-slate-900">Data, ML & AI:</span> TensorFlow, PyTorch, Pandas/NumPy, Monte Carlo & Latin Hypercube
                    </div>
                    <div>
                        <span class="font-semibold text-slate-900">Systems & Tools:</span> Git/GitHub, Linux, SQL, ANSYS, SolidWorks
                    </div>
                    <div>
                        <span class="font-semibold text-slate-900">Core Strengths:</span> Root-cause analysis, process automation
                    </div>
                </div>
            </section>

            <footer class="pt-10 border-t border-slate-200 text-sm text-slate-400 uppercase tracking-widest text-center font-medium">
                {name} • BITS Pilani
            </footer>
            
        </main>
    </body>
</html>
---