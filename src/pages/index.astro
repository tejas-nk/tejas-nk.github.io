---
import '../styles/global.css';

const name = "Tejas Kulkarni";
const email = "f20240460@goa.bits-pilani.ac.in";
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{name} | Curriculum Vitae</title>
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&display=swap" rel="stylesheet">
    </head>
    
    <body class="bg-[#FAFAFA] text-[#111111] font-['Newsreader'] antialiased selection:bg-sky-100">
        
        <div class="h-1.5 w-full bg-gradient-to-r from-sky-300 via-lime-300 to-[#FAFAFA]"></div>

        <header class="w-full border-b border-slate-200 bg-[#FAFAFA]/90 backdrop-blur-sm sticky top-0 z-50">
            <div class="max-w-3xl mx-auto px-6 h-16 flex items-center justify-between text-[15px]">
                <a href="/" class="font-medium tracking-tight text-slate-800 hover:text-sky-600 transition-colors">
                    {name}
                </a>
                <nav class="flex items-center gap-6 font-medium text-slate-500">
                    <a href="/" class="text-slate-900 border-b border-slate-900 pb-0.5">CV</a>
                    <a href="/photography" class="hover:text-slate-900 transition-colors pb-0.5">Photography</a>
                    <a href={`mailto:${email}`} class="hover:text-slate-900 transition-colors pb-0.5">Email</a>
                </nav>
            </div>
        </header>

        <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">
            
            <section class="mb-24">
                <div class="flex flex-col md:flex-row justify-between md:items-end mb-10 gap-6">
                    <div>
                        <h1 class="text-4xl md:text-5xl tracking-tight mb-2 text-slate-900 font-medium">
                            {name}
                        </h1>
                        <p class="text-slate-600 font-medium text-lg">
                            BITS Pilani, Goa Campus
                        </p>
                    </div>
                    <a href={`mailto:${email}`} class="border border-sky-200 text-sky-700 px-5 py-2 rounded-full text-[15px] font-medium hover:bg-sky-50 transition-colors">
                        Email Me
                    </a>
                </div>
                
                <h2 class="text-2xl md:text-3xl leading-snug text-slate-800 max-w-2xl font-medium">
                    Aspiring Mechanical Engineer with key interests in <span class="bg-lime-100/70 text-lime-900 px-1.5 py-0.5 rounded-sm">Artificial Intelligence</span>, Digital Twins, and Robotics.
                </h2>

                <div class="flex gap-5 mt-10 text-[15px] font-medium text-slate-500">
                    <a href="https://github.com/tejas-nk" class="hover:text-sky-700 underline underline-offset-4 decoration-slate-200 transition-colors">GitHub</a>
                    <a href="https://www.linkedin.com/in/tejaskulkarni25" class="hover:text-sky-700 underline underline-offset-4 decoration-slate-200 transition-colors">LinkedIn</a>
                    <a href="/tejas_kulkarni_cv.pdf" target="_blank" class="hover:text-sky-700 underline underline-offset-4 decoration-slate-200 transition-colors">Download PDF</a>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Education</h3>
                
                <div class="flex flex-col md:flex-row justify-between items-start gap-2">
                    <div>
                        <h4 class="text-xl font-medium text-slate-900">BITS Pilani, Goa Campus</h4>
                        <p class="text-slate-600 mt-1 text-[17px]">B.E. Mechanical Engineering</p>
                    </div>
                    <div class="md:text-right mt-2 md:mt-0">
                        <p class="text-[15px] text-slate-500 font-medium">2024 — 2028</p>
                        <p class="text-[15px] font-semibold text-slate-900 mt-1">CGPA: <span class="text-sky-600">9.2/10</span></p>
                    </div>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Projects</h3>
                
                <div class="space-y-12">
                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Digital Twin for Thermo-Mechanical Analysis</h4>
                            <span class="text-[15px] text-slate-500 font-medium">2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Ansys, Python</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Worked on uncertainty-aware physics-based analysis of cryogenic pipe support structures found in Particle Accelerators and LNG supplier structures.</li>
                            <li>Analysed model performance by Monte Carlo simulations and Latin-Hypercube Sampling and performed thermo-mechanical data analysis.</li>
                            <li>Digital twin evaluates multiple scenarios and based on them, a design dashboard is created.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Multiphase Heat Transfer Modeling</h4>
                            <span class="text-[15px] text-slate-500 font-medium">2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Ansys Fluent, MATLAB</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Modeled multiphase flow and phase-change heat transfer in a closed-loop Pulsating Heat Pipe system.</li>
                            <li>Analyzed system behavior under varying surface conditions and optimized thermal performance.</li>
                            <li>Validated simulations using pre-existing literature.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Photon Count Data Analysis for Experimental Optics</h4>
                            <span class="text-[15px] text-slate-500 font-medium">2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Python, SciPy, NumPy</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Processed and analyzed high-frequency photon count datasets from optical experiments.</li>
                            <li>Applied statistical analysis, noise filtering, and signal smoothing using SciPy.</li>
                            <li>Identified patterns and anomalies through curve fitting in photon intensity distributions to improve data reliability.</li>
                            <li>Built Python pipelines to automate data cleaning, visualization, and analysis workflows, reducing manual effort.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">ANSYS Technology Hackathon</h4>
                            <span class="text-[15px] text-slate-500 font-medium">2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">1st Place • Ansys Fluent</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Won 1st place in ANSYS Technology Hackathon.</li>
                            <li>Designed and optimized an engineering system improving performance by 24%.</li>
                        </ul>
                    </article>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Publications & Conferences</h3>
                
                <div class="space-y-12">
                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Algorithmic Efficiency in Quantum Incident Data</h4>
                            <span class="text-[15px] text-slate-500 font-medium italic">In Preparation</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-3">Manuscript</p>
                        <p class="text-[17px] leading-relaxed text-slate-700 ml-1">
                            Co-authoring a comprehensive manuscript evaluating curve-fitting algorithms and noise reduction implementations optimized for Avalanche Photo Diode configurations.
                        </p>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">ICIST — International Conference</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Oct 2025</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-3">Best Speaker Award • Presentation</p>
                        <p class="text-[17px] leading-relaxed text-slate-700 ml-1">
                            Topic: <i class="text-slate-900">Delayed Luminescence in Plants</i>. Presented technical instrumentation insights regarding experimental optics. Under supervision of Dr. Yuriy Petenev.
                        </p>
                    </article>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Research & Experience</h3>
                
                <div class="space-y-12">
                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Undergraduate Researcher</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Aug 2025 — May 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Optics Lab, Dept of Physics, BITS Goa</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Worked with experimental optical systems involving photon detection and data acquisition.</li>
                            <li>Performed data analysis and statistical processing using Python and SciPy, improving data reliability through structured validation techniques.</li>
                            <li>Designed support structures for complex optical setups using additive manufacturing.</li>
                        </ul>
                    </article>

                    <article>
                        <div class="flex justify-between items-baseline mb-1">
                            <h4 class="text-xl font-medium text-slate-900">Undergraduate Teaching Assistant</h4>
                            <span class="text-[15px] text-slate-500 font-medium">Aug 2025 — May 2026</span>
                        </div>
                        <p class="text-sm font-semibold text-sky-600 uppercase tracking-wider mb-4">Course: Engineering Design and Prototyping</p>
                        <ul class="list-disc list-outside ml-5 space-y-2.5 text-[17px] leading-relaxed text-slate-700">
                            <li>Mentored 400+ students in structured problem-solving and engineering design workflows.</li>
                            <li>Evaluated assignments and guided project development.</li>
                        </ul>
                    </article>
                </div>
            </section>

            <section class="mb-24">
                <h3 class="text-lg font-semibold uppercase tracking-widest text-slate-500 mb-8 border-b border-slate-200 pb-3">Technical Skills</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-5 gap-x-8 text-[17px] text-slate-700">
                    <div>
                        <span class="font-semibold text-slate-900">Programming:</span> Python, C/C++, MATLAB
                    </div>
                    <div>
                        <span class="font-semibold text-slate-900">Data Analysis:</span> NumPy, SciPy, Pandas, Matplotlib
                    </div>
                    <div>
                        <span class="font-semibold text-slate-900">Tools:</span> ANSYS (Fluent), SolidWorks, AutoCAD, Fusion
                    </div>
                    <div>
                        <span class="font-semibold text-slate-900">AI/ML:</span> TensorFlow, PyTorch, Deep Learning (basic)
                    </div>
                </div>
            </section>

            <footer class="pt-10 border-t border-slate-200 text-sm text-slate-400 uppercase tracking-widest text-center font-medium">
                Tejas Kulkarni • BITS Pilani
            </footer>
            
        </main>
    </body>
</html>